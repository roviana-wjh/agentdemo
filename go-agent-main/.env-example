# 模型类型配置
CHAT_MODEL_TYPE=your-model-type
INTENT_MODEL_TYPE=your-model-type
EMBEDDING_MODEL_TYPE=your-model-type
VECTOR_DB_TYPE=your-vector-db

# ark基本配置
ARK_KEY=your-api-key
ARK_CHAT_MODEL=your-chat-model
ARK_EMBEDDING_MODEL=your-embedding-model

# openAI基本配置
OPENAI_KEY=your-api-key
OPENAI_CHAT_MODEL=your-chat-model
OPENAI_EMBEDDING_MODEL=your-embedding-model

# qwen基本配置
QWEN_BASE_URL=your-region-baseurl
QWEN_KEY=your-api-key
QWEN_CHAT_MODEL=your-chat-model
QWEN_EMBEDDING_MODEL=your-embedding-model

# gemini基本配置
GEMINI_KEY=your-api-key
GEMINI_CHAT_MODEL=your-chat-model
GEMINI_EMBEDDING_MODEL=your-embedding-model

# milvus基本配置
MILVUS_ADDR=your-addr
MILVUS_USERNAME=your-username
MILVUS_PASSWORD=your-password
MILVUS_SIMILARITY_THRESHOLD=your-similarity-threshold
MILVUS_COLLECTION_NAME=your-collection-name
TOPK=your-top

# ES基本配置
ES_ADDRESS=your-addr1,your-addr2
ES_USERNAME=your-username
ES_PASSWORD=your-password
ES_INDEX=blog_article_chunks_v1

# Redis与会话Memory配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
MEMORY_KEY_PREFIX=ai-blog
MEMORY_HISTORY_TTL=24h
MEMORY_SUMMARY_TTL=168h
MEMORY_RECENT_MESSAGE_COUNT=8

# Hybrid Search与Rerank配置
HYBRID_ES_TOP_K=20
HYBRID_MILVUS_TOP_K=20
HYBRID_RRF_K=60
HYBRID_RERANK_MODE=llm
HYBRID_RERANK_CANDIDATE_K=10
HYBRID_FINAL_TOP_K=5
HYBRID_RERANK_MAX_CONTENT_LENGTH=800

# Blog API（基础博客领域 Tool）
BLOG_API_BASE_URL=http://127.0.0.1:8080
BLOG_INTERNAL_TOKEN=replace-with-a-long-random-secret
BLOG_API_TIMEOUT=10s

# langsmith基本配置
LANG_SMITH_KEY=your-api-key
LANG_SMITH_URL=your-api-url

# cozeloop基本配置
COZELOOP_WORKSPACE_ID=your-workspace-id
COZELOOP_JWT_OAUTH_CLIENT_ID=your-client-id
COZELOOP_JWT_OAUTH_PRIVATE_KEY=your-private-key
COZELOOP_JWT_OAUTH_PUBLIC_KEY_ID=your-public-key

# MySQL基本配置
MYSQL_HOST=your-host
MYSQL_PORT=your-port
MYSQL_USERNAME=your-username
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database
# Optional comma-separated additions to the built-in content review word list.
REVIEW_SENSITIVE_WORDS=
