package collaborative_writing

import (
	"context"
	"fmt"
	"log"
	"time"
)

// OperationRequest 运营请求
type OperationRequest struct {
	AuthorID      uint                   `json:"author_id"`
	TopicCount    int                    `json:"topic_count"`     // 生成主题数量
	SelectCount   int                    `json:"select_count"`    // 选择主题数量
	Strategy      string                 `json:"strategy"`        // "balanced", "trending", "quality"
	AutoPublish   bool                   `json:"auto_publish"`    // 是否自动发布
	Preferences   map[string]interface{} `json:"preferences"`     // 用户偏好
}

// OperationResult 运营结果
type OperationResult struct {
	Success       bool              `json:"success"`
	TopicsSuggested []TopicSuggestion `json:"topics_suggested"`
	TopicsSelected  []TopicSuggestion `json:"topics_selected"`
	Articles      []ArticleResult   `json:"articles"`
	TotalTime     time.Duration     `json:"total_time"`
	Error         string            `json:"error,omitempty"`
}

// ArticleResult 单篇文章结果
type ArticleResult struct {
	Topic         string           `json:"topic"`
	WritingResult WritingResult    `json:"writing_result"`
	SEO           SEOOptimization  `json:"seo"`
	Publish       PublishResult    `json:"publish"`
}

// OperationSystem 运营系统
type OperationSystem struct {
	topicPlanner  *TopicPlannerAgent
	director      *DirectorAgent
	writingGraph  interface{} // 写作Graph
	seoAgent      *SEOAgent
	publisher     *PublisherAgent
	monitor       *MonitorAgent
}

// NewOperationSystem 创建运营系统
func NewOperationSystem(ctx context.Context) (*OperationSystem, error) {
	// 获取ChatModel
	chatModel, err := getChatModel(ctx)
	if err != nil {
		return nil, fmt.Errorf("get chat model: %w", err)
	}

	// 创建各Agent
	topicPlanner := NewTopicPlannerAgent(chatModel)
	director := NewDirectorAgent(chatModel)
	seoAgent := NewSEOAgent(chatModel)

	publisher, err := NewPublisherAgent()
	if err != nil {
		log.Printf("警告: Publisher初始化失败: %v", err)
	}

	monitor, err := NewMonitorAgent(chatModel)
	if err != nil {
		log.Printf("警告: Monitor初始化失败: %v", err)
	}

	// 获取写作Graph
	writingGraph, err := GetCollaborativeWritingGraph()
	if err != nil {
		return nil, fmt.Errorf("get writing graph: %w", err)
	}

	return &OperationSystem{
		topicPlanner: topicPlanner,
		director:     director,
		writingGraph: writingGraph,
		seoAgent:     seoAgent,
		publisher:    publisher,
		monitor:      monitor,
	}, nil
}

// Run 运行完整的运营流程
func (s *OperationSystem) Run(ctx context.Context, req OperationRequest) (OperationResult, error) {
	startTime := time.Now()
	log.Printf("🚀 [Operation] 开始运营流程")

	result := OperationResult{
		Success: true,
	}

	// Step 1: 选题规划
	log.Printf("📋 [Operation] Step 1: 选题规划")
	topics, err := s.topicPlanner.SuggestTopics(ctx, req.TopicCount, req.Preferences)
	if err != nil {
		return OperationResult{Success: false, Error: err.Error()}, err
	}
	result.TopicsSuggested = topics

	// Step 2: 总监决策
	log.Printf("👔 [Operation] Step 2: 总监决策")
	selection, err := s.director.SelectTopics(ctx, topics, req.SelectCount, req.Strategy)
	if err != nil {
		return OperationResult{Success: false, Error: err.Error()}, err
	}
	result.TopicsSelected = selection.SelectedTopics
	log.Printf("   选择理由: %s", selection.Reason)

	// Step 3: 并行写作
	log.Printf("✍️ [Operation] Step 3: 并行写作（%d篇文章）", len(selection.SelectedTopics))
	articles := make([]ArticleResult, len(selection.SelectedTopics))

	for i, topic := range selection.SelectedTopics {
		log.Printf("   [%d/%d] 写作: %s", i+1, len(selection.SelectedTopics), topic.Topic)

		// 执行写作流程
		articleResult, err := s.writeArticle(ctx, req.AuthorID, topic, req.AutoPublish)
		if err != nil {
			log.Printf("   ❌ 写作失败: %v", err)
			articles[i] = ArticleResult{
				Topic: topic.Topic,
				WritingResult: WritingResult{
					Success: false,
					Error:   err.Error(),
				},
			}
			continue
		}

		articles[i] = articleResult
		log.Printf("   ✅ 完成: ArticleID=%d, 得分=%.1f",
			articleResult.Publish.ArticleID, articleResult.WritingResult.ReviewScore)
	}

	result.Articles = articles
	result.TotalTime = time.Since(startTime)

	log.Printf("🎉 [Operation] 运营流程完成，总耗时: %v", result.TotalTime)
	log.Printf("   成功: %d/%d", s.countSuccess(articles), len(articles))

	return result, nil
}

// writeArticle 写作单篇文章（完整流程）
func (s *OperationSystem) writeArticle(
	ctx context.Context,
	authorID uint,
	topic TopicSuggestion,
	autoPublish bool,
) (ArticleResult, error) {
	// Step 1: 协作写作
	writingReq := WritingRequest{
		Topic:        topic.Topic,
		Requirements: topic.Reason,
		AuthorID:     authorID,
		TargetWords:  topic.TargetWords,
		Difficulty:   topic.Difficulty,
	}

	graph := s.writingGraph.(interface {
		Generate(context.Context, WritingRequest) (WritingResult, error)
	})

	writingResult, err := graph.Generate(ctx, writingReq)
	if err != nil {
		return ArticleResult{}, fmt.Errorf("writing failed: %w", err)
	}

	// Step 2: SEO优化
	seo, err := s.seoAgent.Optimize(ctx, writingResult.Content[:100], writingResult.Content, topic.Keywords)
	if err != nil {
		log.Printf("   警告: SEO优化失败: %v", err)
		// 使用默认SEO
		seo = SEOOptimization{
			OptimizedTitle:  topic.Topic,
			MetaDescription: topic.Reason,
			Keywords:        topic.Keywords,
			Tags:            topic.Keywords,
			Slug:            "",
		}
	}

	// Step 3: 发布
	var publishResult PublishResult
	if s.publisher != nil {
		publishResult, err = s.publisher.Publish(ctx, authorID, topic.Topic, writingResult.Content, seo, autoPublish)
		if err != nil {
			log.Printf("   警告: 发布失败: %v", err)
		}
	}

	return ArticleResult{
		Topic:         topic.Topic,
		WritingResult: writingResult,
		SEO:           seo,
		Publish:       publishResult,
	}, nil
}

// countSuccess 统计成功数量
func (s *OperationSystem) countSuccess(articles []ArticleResult) int {
	count := 0
	for _, article := range articles {
		if article.WritingResult.Success {
			count++
		}
	}
	return count
}

